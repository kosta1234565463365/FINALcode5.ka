[Unit]
Description=5ka-collector - автономный парсер скидок Пятёрочки
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/5ka_bot
Environment=PYTHONPATH=/opt/5ka_bot
ExecStart=/opt/5ka_bot/venv/bin/python -m collector.runner
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
